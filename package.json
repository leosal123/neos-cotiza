{
  "name": "neos-cotiza",
  "version": "1.1.1",
  "description": "Cotizador local y sin conexión de Neos Linx.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "preview": "node scripts/server.mjs --dist",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs && node scripts/build.mjs",
    "test": "node --test",
    "package": "npm run build && node scripts/package.mjs"
  }
}
